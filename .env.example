# Copy to .env next to this file, fill in, then: chmod 600 .env
# Keep .env OUTSIDE any synced or backed-up folder. Never commit it.

# --- Database (only reachable inside the compose network)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Address
# Your Tailscale name, so the phone trusts the certificate (see docs/runbook.md).
LT_SITE_ADDRESS=loans.your-tailnet.ts.net
LT_APP_ORIGIN=https://loans.your-tailnet.ts.net
# The Tailscale IP of this machine (tailscale ip -4). Never 0.0.0.0 on a machine the router forwards to.
LT_BIND_ADDRESS=100.x.y.z

# --- Secrets (generate them as shown in docs/runbook.md, section 1.3)
# Aadhaar master keyring: a file OUTSIDE the data and backup folders, with an offline recovery copy.
LT_KEYRING_PATH=/srv/loantracker-keys/aadhaar_keyring.json
LT_AADHAAR_HMAC_SECRET=
LT_SESSION_SECRET=
LT_FILE_LINK_SECRET=

# --- Backups
# Passphrase for backup encryption: a file outside the backup folders (keep a copy offline too).
BACKUP_PASSPHRASE_PATH=/srv/loantracker-keys/backup_passphrase
BACKUP_SECOND_DRIVE=/mnt/backup-drive
BACKUP_OFFSITE_DIR=/home/owner/OffsiteSync
BACKUP_AT=01:30

# --- Optional alerts (nothing leaves the machine unless you fill these in)
LT_SMTP_HOST=
LT_SMTP_PORT=587
LT_SMTP_USER=
LT_SMTP_PASSWORD=
LT_ALERT_EMAIL_TO=
# Web push for the daily summary on the phone (generate with: npx web-push generate-vapid-keys)
LT_VAPID_PUBLIC_KEY=
LT_VAPID_PRIVATE_KEY=
LT_VAPID_SUBJECT=mailto:you@example.com

# --- Optional offline breached-password list (SHA-1 per line, e.g. the HIBP download)
# LT_BREACHED_PASSWORDS_FILE=/srv/loantracker-keys/pwned-sha1.txt

LT_ENV=production
LT_LOG_LEVEL=INFO
